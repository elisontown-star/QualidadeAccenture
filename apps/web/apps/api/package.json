{
  "name": "quality-platform-api",
  "version": "1.0.0",
  "private": true,
  "scripts": {
    "dev": "wrangler dev",
    "build": "wrangler deploy --dry-run",
    "deploy": "wrangler deploy",
    "db:migrate": "wrangler d1 execute quality-platform-db --file=../../database/migrations/001_initial_schema.sql",
    "db:migrate:prod": "wrangler d1 execute quality-platform-db-prod --file=../../database/migrations/001_initial_schema.sql --env production",
    "db:seed": "wrangler d1 execute quality-platform-db --file=../../database/seeds/001_admin.sql",
    "type-check": "tsc --noEmit"
  },
  "dependencies": {
    "hono": "^4.6.0",
    "xlsx": "^0.18.5"
  },
  "devDependencies": {
    "@cloudflare/workers-types": "^4.20241224.0",
    "typescript": "^5.6.0",
    "wrangler": "^3.95.0"
  }
}
